# ─── Krishi Mitra Backend — Environment Variables ─────────────────────────────
#
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env to git.

# ── Gemini AI ───────────────────────────────────────────────────────────────────
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Plant Disease ML Model ──────────────────────────────────────────────────────
# Path to trained .h5 model file (relative to krishi-backend/)
# The file krishi-backend/model/krishi_model.h5 already exists.
MODEL_PATH=./model/krishi_model.h5

# Set to "true" only if the model file is missing — returns labeled MOCK results.
# Set to "false" (default) to use the real model for inference.
USE_MOCK_MODEL=false

# ── Weather ────────────────────────────────────────────────────────────────────
# Get yours at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_api_key_here

# ── Agmarknet Mandi (optional) ──────────────────────────────────────────────────
# Get yours at: https://data.gov.in/
# Without this key the backend falls back to indicative state-level mock data.
AGMARKNET_KEY=your_agmarknet_api_key_here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Local dev: keep defaults. Production: set to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
